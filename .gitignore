# --- Data --------------------------------------------------------------
# Décommenter pour exclure les données brutes/traitées du versioning
# (volumineuses ou sensibles). data/sample/ reste toujours suivi.
# data/raw/*
# data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- Power BI ----------------------------------------------------------------
~$*.pbix
*.pbix.bak

# Power BI Project (.pbip) — cache & paramètres locaux, spécifiques à la machine
**/.pbi/cache/
**/.pbi/*.abf
**/.pbi/localSettings.json
**/*.pbip.bak

# --- Tableau ----------------------------------------------------------------
~$*.twbx
*.twbx.bak
*.tde
*.hyper.lock

# --- Secrets / config locale --------------------------------------------------
.env
.env.*
!.env.example
credentials.json
*.key

# --- Local dev / notes de travail (spécifiques à la machine, pas pour le repo partagé) ---
.mcp.json
build.md

# --- Logs ----------------------------------------------------------------
*.log

# --- Éditeurs ----------------------------------------------------------------
.vscode/
.idea/
*.swp
