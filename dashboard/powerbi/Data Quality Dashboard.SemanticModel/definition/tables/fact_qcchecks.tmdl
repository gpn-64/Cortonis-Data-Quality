				        "Property": "Time to Resolve"
				      }
				    }
				  ],
				  "binningMetadata": {
				    "binSize": {
				      "value": 10.0,
				      "unit": 0
				    }
				  }
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"f","Entity":"fact_qcchecks"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Time to Resolve"}}],"BinItem":{"Expression":{"Floor":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Time to Resolve"}},"Size":10.0}}}}

		annotation SummarizationSetBy = Automatic

	column 'Correction Target Date Met?' = ```
			
			
			VAR __Target = 
			SWITCH(
			    TRUE(),
			    RELATED(dim_process[Criticality]) = "Minor", 30,
			    RELATED(dim_process[Criticality]) = "Major", 45,
			    RELATED(dim_process[Criticality]) = "Critical", 60
			)
			
			RETURN
			
			IF(
			    fact_qcchecks[Time to Resolve] <= __Target,
			    TRUE,
			    FALSE
			)
			    
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: dc8418c5-6b5d-4a36-b3ba-399af16fd3b4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

