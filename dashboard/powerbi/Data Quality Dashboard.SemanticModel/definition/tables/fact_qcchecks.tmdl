	column 'Right First Time' =
			
			if( fact_qcchecks[Finding Resolution Date] = fact_qcchecks[Record Created Date],TRUE,FALSE)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: bd56bf05-0795-40f9-a4fc-2960990645c2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Finding ID'
		dataType: string
		lineageTag: 8547b5bb-8bd7-4230-864f-18543854202e
		summarizeBy: none
		sourceColumn: Finding ID

	column 'Time to Resolve' =
			
			IF (
			    fact_qcchecks[Check Status] = "Finding Corrected",
			    DATEDIFF (
			        fact_qcchecks[Finding Detection Date],
			        fact_qcchecks[Finding Resolution Date],
			        DAY
			    ),
			    BLANK ()
			)
		formatString: 0
		lineageTag: f57d6b6f-0385-428e-9c99-79f020bfaa9a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"fact_qcchecks","TableItemName":"Time to Resolve (bins)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'Time to Resolve (bins)' =
			IF(
				ISBLANK('fact_qcchecks'[Time to Resolve]),
				BLANK(),
				INT('fact_qcchecks'[Time to Resolve] / 10) * 10
			)
		formatString: 0
		lineageTag: 380e8cee-8ba2-4a7a-af6c-c42c45401ac8
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
				    {
				      "Column": {
				        "Expression": {
				          "SourceRef": {
				            "Entity": "fact_qcchecks"
				          }
