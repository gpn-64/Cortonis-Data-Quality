	column 'Is Year To Date'
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 790c0be8-6300-4db5-8b5d-4d101dc6bcfa
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Year To Date]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				
				
				// ---------- Configuration -------------------------------------------
				VAR _FiscalStartMonth = 1        // 1 = calendar FY, 4 = FY starts in April, etc.
				VAR _FYLabelOnEndYear = TRUE     // TRUE  -> Apr-2025 belongs to FY2026
				                                 // FALSE -> Apr-2025 belongs to FY2025
				VAR _FirstYear = YEAR ( MIN ( fact_qcchecks[Record Created Date] ) )   // <-- your fact date column
				VAR _LastYear  = YEAR ( MAX ( fact_qcchecks[Record Created Date] ) )   // <-- your fact date column
				// Alternative: VAR _FirstYear = 2018   VAR _LastYear = YEAR ( TODAY () ) + 1
				
				// ---------- Helpers --------------------------------------------------
				VAR _Pad = IF ( _FiscalStartMonth = 1, 0, 1 )   // extra year so fiscal years are complete
				VAR _FYShiftAfter  = IF ( _FiscalStartMonth = 1, 0, IF ( _FYLabelOnEndYear, 1, 0 ) )
				VAR _FYShiftBefore = IF ( _FiscalStartMonth = 1, 0, IF ( _FYLabelOnEndYear, 0, -1 ) )
				
				VAR _Today          = TODAY ()
				VAR _TodayMonthIdx  = YEAR ( _Today ) * 12 + MONTH ( _Today )
				VAR _TodayQtrIdx    = YEAR ( _Today ) * 4 + INT ( ( MONTH ( _Today ) - 1 ) / 3 ) + 1
				VAR _TodayWeekStart = _Today - WEEKDAY ( _Today, 3 )          // Monday of current week
				VAR _TodayFY =
				    YEAR ( _Today )
				        + IF ( MONTH ( _Today ) >= _FiscalStartMonth, _FYShiftAfter, _FYShiftBefore )
				
				// ---------- Base grain (columns reusable in the outer ADDCOLUMNS) -----
				VAR _Base =
				    ADDCOLUMNS (
				        CALENDAR ( DATE ( _FirstYear - _Pad, 1, 1 ), DATE ( _LastYear + _Pad, 12, 31 ) ),
				        "Year",                YEAR ( [Date] ),
				        "Month Number",        MONTH ( [Date] ),
				        "Quarter Number",      INT ( ( MONTH ( [Date] ) - 1 ) / 3 ) + 1,
				        "Fiscal Month Number", MOD ( MONTH ( [Date] ) - _FiscalStartMonth + 12, 12 ) + 1,
				        "Fiscal Year",
				            YEAR ( [Date] )
				                + IF ( MONTH ( [Date] ) >= _FiscalStartMonth, _FYShiftAfter, _FYShiftBefore )
				    )
				
				RETURN
				ADDCOLUMNS (
				    _Base,
				
				    // ---------- Keys ------------------------------------------------
				    "Date Key",             VALUE ( FORMAT ( [Date], "YYYYMMDD" ) ),
				
				    // ---------- Calendar labels -------------------------------------
				    "Quarter",              "Q" & [Quarter Number],
				    "Year Quarter",         [Year] & "-Q" & [Quarter Number],
				    "Year Quarter Number",  [Year] * 4 + [Quarter Number],                  // sort key
				    "Month Name",           FORMAT ( [Date], "MMMM" ),
				    "Month Short",          FORMAT ( [Date], "MMM" ),
				    "Year Month",           FORMAT ( [Date], "YYYY-MM" ),
				    "Month Year Short",     FORMAT ( [Date], "MMM YYYY" ),
				    "Year Month Number",    [Year] * 12 + [Month Number],                   // sort key
				    "Day",                  DAY ( [Date] ),
				    "Day Of Year",          DATEDIFF ( DATE ( [Year], 1, 1 ), [Date], DAY ) + 1,
				    "Day Of Week Number",   WEEKDAY ( [Date], 2 ),                          // Monday = 1
				    "Day Name",             FORMAT ( [Date], "DDDD" ),
				    "Day Short",            FORMAT ( [Date], "DDD" ),
				
				    // ---------- ISO 8601 weeks --------------------------------------
				    "ISO Week",             WEEKNUM ( [Date], 21 ),
				    "ISO Year",             YEAR ( [Date] + 4 - WEEKDAY ( [Date], 3 ) ),
				    "ISO Year Week",
				        YEAR ( [Date] + 4 - WEEKDAY ( [Date], 3 ) ) & "-W"
				            & FORMAT ( WEEKNUM ( [Date], 21 ), "00" ),
				    "ISO Year Week Number",
				        YEAR ( [Date] + 4 - WEEKDAY ( [Date], 3 ) ) * 100 + WEEKNUM ( [Date], 21 ),
				
				    // ---------- Period boundaries (useful for custom TI patterns) ----
				    "Start Of Week",        [Date] - WEEKDAY ( [Date], 3 ),                 // Monday
				    "End Of Week",          [Date] - WEEKDAY ( [Date], 3 ) + 6,
				    "Start Of Month",       DATE ( [Year], [Month Number], 1 ),
				    "End Of Month",         EOMONTH ( [Date], 0 ),
				    "Start Of Quarter",     DATE ( [Year], ( [Quarter Number] - 1 ) * 3 + 1, 1 ),
				    "End Of Quarter",       EOMONTH ( DATE ( [Year], ( [Quarter Number] - 1 ) * 3 + 1, 1 ), 2 ),
				    "Start Of Year",        DATE ( [Year], 1, 1 ),
				    "End Of Year",          DATE ( [Year], 12, 31 ),
				    "Days In Month",        DAY ( EOMONTH ( [Date], 0 ) ),
				
				    // ---------- Fiscal ----------------------------------------------
				    "Fiscal Quarter Number",  INT ( ( [Fiscal Month Number] - 1 ) / 3 ) + 1,
				    "Fiscal Quarter",         "FQ" & INT ( ( [Fiscal Month Number] - 1 ) / 3 ) + 1,
				    "Fiscal Year Label",      "FY" & [Fiscal Year],
				    "Fiscal Year Quarter",    "FY" & [Fiscal Year] & "-Q"
				                                  & ( INT ( ( [Fiscal Month Number] - 1 ) / 3 ) + 1 ),
				    "Fiscal Year Quarter Number",
				        [Fiscal Year] * 4 + INT ( ( [Fiscal Month Number] - 1 ) / 3 ) + 1,  // sort key
				    "Fiscal Year Month Number", [Fiscal Year] * 12 + [Fiscal Month Number], // sort key
				
				    // ---------- Relative offsets (0 = current period) ----------------
				    "Day Offset",     DATEDIFF ( _Today, [Date], DAY ),
				    "Week Offset",    DIVIDE ( DATEDIFF ( _TodayWeekStart,
				                                          [Date] - WEEKDAY ( [Date], 3 ), DAY ), 7 ),
				    "Month Offset",   [Year] * 12 + [Month Number] - _TodayMonthIdx,
				    "Quarter Offset", [Year] * 4 + [Quarter Number] - _TodayQtrIdx,
				    "Year Offset",    [Year] - YEAR ( _Today ),
				    "Fiscal Year Offset", [Fiscal Year] - _TodayFY,
				
				    // ---------- Flags ------------------------------------------------
				    "Is Weekend",         WEEKDAY ( [Date], 2 ) >= 6,
				    "Is Workday",         WEEKDAY ( [Date], 2 ) < 6,   // holidays not handled here
				    "Is Current Day",     [Date] = _Today,
				    "Is Current Week",    [Date] - WEEKDAY ( [Date], 3 ) = _TodayWeekStart,
				    "Is Current Month",   [Year] * 12 + [Month Number] = _TodayMonthIdx,
				    "Is Current Quarter", [Year] * 4 + [Quarter Number] = _TodayQtrIdx,
				    "Is Current Year",    [Year] = YEAR ( _Today ),
				    "Is Current Fiscal Year", [Fiscal Year] = _TodayFY,
				    "Is Past",            [Date] < _Today,
				    "Is Future",          [Date] > _Today,
				    "Is Last 12 Months",  [Date] > EDATE ( _Today, -12 ) && [Date] <= _Today,
				    "Is Year To Date",    [Year] = YEAR ( _Today ) && [Date] <= _Today
				)
				
				
				// =====================================================================
				//  POST-CREATION CHECKLIST
				// =====================================================================
				//  1. Mark as date table -> [Date]  (mandatory for DATESYTD, DATEADD, etc.)
				//  2. Sort by column:
				//       Month Name         -> Month Number
				//       Month Short        -> Month Number
				//       Day Name           -> Day Of Week Number
				//       Day Short          -> Day Of Week Number
				//       Month Year Short   -> Year Month Number
				//       Year Quarter       -> Year Quarter Number
				//       Fiscal Year Quarter-> Fiscal Year Quarter Number
				//       ISO Year Week      -> ISO Year Week Number
				//  3. Hide the sort/index columns from report view.
				//  4. Set Data category = Date on [Date]; summarization = None on all numerics.
				//  5. Non-calendar fiscal year: DATESYTD ( 'Date'[Date], "3/31" ) for FY ending Mar 31.
				//  6. FORMAT() returns names in the model culture. For guaranteed English regardless
				//     of locale, replace "Month Name" / "Day Name" with an explicit SWITCH, e.g.:
				//        "Month Name", SWITCH ( MONTH ( [Date] ),
				//            1, "January", 2, "February", 3, "March", 4, "April",
				//            5, "May", 6, "June", 7, "July", 8, "August",
				//            9, "September", 10, "October", 11, "November", "December" ),
				// =====================================================================
				
				```

	annotation PBI_Id = 42ae23f0698640c99ac89984e1008eed

